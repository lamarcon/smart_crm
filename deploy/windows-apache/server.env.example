# Copy to C:\ProgramData\SmartCRM\server.env and replace the password.
# Generate the password with:
#   -join ((48..57) + (97..102) | Get-Random -Count 64 | ForEach-Object {[char]$_})

SMART_CRM_DB_NAME=smartcrm
SMART_CRM_DB_USER=smartcrm
SMART_CRM_DB_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
SMART_CRM_DB_HOST=127.0.0.1
SMART_CRM_DB_PORT=5432
SMART_CRM_BIND_IP=127.0.0.1
SMART_CRM_PORT=8080
