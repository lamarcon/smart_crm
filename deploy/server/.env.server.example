# Copy this file to the repository root as .env.server.
# Generate the password with: openssl rand -hex 32
# Keep the generated value URL-safe because it is embedded in the database URL.

COMPOSE_PROJECT_NAME=smart-crm-server
SMART_CRM_DB_NAME=smartcrm
SMART_CRM_DB_USER=smartcrm
SMART_CRM_DB_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
SMART_CRM_BIND_IP=127.0.0.1
SMART_CRM_PORT=8080
SMART_CRM_IMAGE_TAG=server

