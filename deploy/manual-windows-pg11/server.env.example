# O instalador copia este modelo para C:\ProgramData\SmartCRM\server.env.
# Nunca coloque a senha real dentro da pasta da aplicacao.
SMART_CRM_DB_NAME=smartcrm
SMART_CRM_DB_USER=smartcrm
SMART_CRM_DB_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
SMART_CRM_DB_HOST=127.0.0.1
SMART_CRM_DB_PORT=5432
SMART_CRM_BIND_IP=127.0.0.1
SMART_CRM_PORT=8080

# Plano de controle central. Substitua o placeholder somente no arquivo externo ao app.
SMART_CRM_CONTROL_DATABASE_URL=REPLACE_WITH_CONTROL_DATABASE_URL
SMART_CRM_TENANT_SECRET_STORE=C:\ProgramData\SmartCRM\tenant-secrets
SMART_CRM_EXPECTED_ORIGIN=https://sc2030.brbots.com

# Pools tenant sao criados sob demanda e permanecem limitados por processo.
SMART_CRM_TENANT_MAX_CACHED_ENGINES=16
SMART_CRM_TENANT_POOL_SIZE=2
SMART_CRM_TENANT_MAX_OVERFLOW=2
SMART_CRM_TENANT_POOL_TIMEOUT_SECONDS=5
SMART_CRM_TENANT_CONNECT_TIMEOUT_SECONDS=3

# Opt-in estrito somente para o tenant BRBots em 127.0.0.1; nao libera hosts remotos.
SMART_CRM_ALLOW_INSECURE_TENANT_LOOPBACK=1

# SMTP para convites e recuperacao de senha. A senha NUNCA fica neste arquivo:
# grave-a com set-smtp-password.ps1 como SmartCRMService (DPAPI).
SMART_CRM_SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMART_CRM_SMTP_PORT=587
SMART_CRM_SMTP_USERNAME=REPLACE_WITH_SMTP_USERNAME
SMART_CRM_SMTP_FROM_ADDRESS=REPLACE_WITH_SMTP_FROM_ADDRESS
SMART_CRM_SMTP_TLS_MODE=starttls
SMART_CRM_SMTP_TIMEOUT_SECONDS=10
SMART_CRM_SMTP_PASSWORD_SECRET_FILE=C:\ProgramData\SmartCRM\service-secrets\smtp-password.bin

# Opcional: IP(s) ou faixa(s) CIDR do balanceador (SLB) que fica na frente do Apache,
# separados por virgula. So assim o CRM usa o IP real do usuario (X-Forwarded-For)
# para limitar tentativas de login. Deixe comentado se nao houver balanceador.
# SMART_CRM_TRUSTED_PROXY_IPS=10.0.0.0/24
